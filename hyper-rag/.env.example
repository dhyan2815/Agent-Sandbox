# Copy to .env and fill in. Never commit .env.
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Any setting in config.yaml can be overridden with a HYPER_RAG_ prefix, e.g.
# HYPER_RAG_LLM_PROVIDER=gemini
# HYPER_RAG_LLM_MODEL=gemini-3.5-flash-lite

# Contact shown to the sites the ingest scripts fetch from (Wikipedia requires one).
# HYPER_RAG_CONTACT=https://github.com/<you>/<your-repo>

# On a host, keep files and indexes in one private Hugging Face bucket (docs/DEPLOY.md).
# HYPER_RAG_BLOB_STORE=hf
# HYPER_RAG_HF_BUCKET=<your username>/hyper-rag
# HF_TOKEN=
